# ── GitHub OAuth Application ──────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Set the Authorization callback URL to:
#   Development:  http://localhost:5173/auth/callback
#   Production:   https://your-domain.com/auth/callback


# ── Server-side variables (never expose these to the browser) ─────────────────

# The OAuth App Client ID — used by api/_lib/oauth.js to exchange the OAuth
# code for an access token, and to revoke the authorization when someone
# signs out.
GITHUB_CLIENT_ID=your_client_id_here

# The OAuth App Client Secret — used by api/_lib/oauth.js for the same two
# calls. This value must NEVER have a VITE_ prefix and must NEVER appear in
# the client-side bundle. Keep it in your server environment only.
GITHUB_CLIENT_SECRET=your_client_secret_here


# ── Client-side variables (safe to include in the browser bundle) ─────────────

# The same Client ID as above, but prefixed with VITE_ so Vite bakes it into
# the frontend bundle. Used by src/pages/Welcome.jsx to build the GitHub OAuth
# redirect URL. This value is public — do not put the Client Secret here.
VITE_GITHUB_CLIENT_ID=your_client_id_here


# ── Optional server configuration ─────────────────────────────────────────────

# The URL of the frontend app. Used by server.js to set the CORS allowed origin.
# Required in production. Defaults to http://localhost:5173 in development.
# FRONTEND_URL=https://your-domain.com

# The port the local Express OAuth server listens on.
# Defaults to 3001. Only needed if port 3001 is already in use.
# PORT=3001
